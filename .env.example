# Virtual Saree Mirror - Environment Variables

# Application
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
TORCH_HOME=./models/

# Camera
CAMERA_DEVICE_ID=0

# Model Paths (optional - uses defaults if not set)
MEDIAPIPE_MODELS_PATH=./models/

# Database
DATABASE_PATH=./database/saree_catalog.db

# Paths
SAREE_LIBRARY_PATH=./sarees/
LOG_PATH=./logs/
CAPTURES_PATH=./captures/
TEMP_PATH=./temp/
